######## functions ######################

# Print dotfiles environment, detected platform variables, and paths on demand
dotinfo() {
  if [ "${1:-}" = "-r" ] || [ "${1:-}" = "--refresh" ]; then
    command -v detect_os_type >/dev/null 2>&1 && export OS_TYPE="$(detect_os_type 2>/dev/null)"
    command -v detect_machine_type >/dev/null 2>&1 && export MACHINE_TYPE="$(detect_machine_type 2>/dev/null)"
    command -v detect_server_type >/dev/null 2>&1 && export SERVER_TYPE="$(detect_server_type 2>/dev/null)"
    command -v detect_arch_type >/dev/null 2>&1 && export ARCH_TYPE="$(detect_arch_type 2>/dev/null)"
    command -v detect_shell_type >/dev/null 2>&1 && export SHELL_TYPE="$(detect_shell_type 2>/dev/null)"
  fi

  local os_type="${OS_TYPE:-unknown}"
  local machine_type="${MACHINE_TYPE:-unknown}"
  local server_type="${SERVER_TYPE:-unknown}"
  local arch_type="${ARCH_TYPE:-unknown}"
  local shell_type="${SHELL_TYPE:-unknown}"
  local hname="$(hostname 2>/dev/null || echo "${HOSTNAME:-unknown}")"
  local raw_virt="$(systemd-detect-virt 2>/dev/null || true)"
  raw_virt="$(echo "$raw_virt" | tr -d '\r\n')"

  local is_hypervisor=0
  if [ "$server_type" = "pve" ] || command -v pveversion >/dev/null 2>&1; then
    is_hypervisor=1
  elif command -v systemctl >/dev/null 2>&1 && \
       systemctl is-active --quiet libvirtd virtqemud pvedaemon 2>/dev/null; then
    is_hypervisor=1
  elif [ -d /sys/class/net/virbr0 ] || [ -d /sys/class/net/vmbr0 ]; then
    is_hypervisor=1
  elif pgrep -x qemu-system-x86_64 >/dev/null 2>&1 || pgrep -x qemu-kvm >/dev/null 2>&1; then
    is_hypervisor=1
  fi

  local virt="bare-metal"
  local virt_role=""

  if [ -n "$raw_virt" ] && [ "$raw_virt" != "none" ]; then
    virt="$raw_virt"
    if [ "$is_hypervisor" = "1" ]; then
      virt_role="(Role: Nested Hypervisor)"
    else
      virt_role="(Role: Guest)"
    fi
  elif [ "$(uname -s 2>/dev/null)" = "Darwin" ] && sysctl -n machdep.cpu.features 2>/dev/null | grep -qi VMM; then
    virt="vm"
    virt_role="(Role: Guest)"
  elif [ "$machine_type" = "guest" ] || [ "$machine_type" = "pveguest" ]; then
    virt="container"
    virt_role="(Role: Guest)"
  elif [ "$is_hypervisor" = "1" ]; then
    virt="bare-metal"
    virt_role="(Role: Hypervisor)"
  else
    virt="bare-metal"
  fi

  local stow_mode="GNU Stow"
  if [ "${machine_type}" = "embedded" ] || [ "${machine_type}" = "router" ] || ! command -v stow >/dev/null 2>&1; then
    stow_mode="dotsync.sh"
  fi

  local pkg_mgr="unknown"
  for pm in apk opkg apt dnf pacman yay brew; do
    if command -v "$pm" >/dev/null 2>&1; then
      pkg_mgr="$pm"
      break
    fi
  done

  local sh_ver=""
  if [ -n "${BASH_VERSION:-}" ]; then
    sh_ver="bash ${BASH_VERSION%%(*}"
  elif [ -n "${ZSH_VERSION:-}" ]; then
    sh_ver="zsh ${ZSH_VERSION}"
  elif command -v busybox >/dev/null 2>&1; then
    sh_ver="$(busybox 2>&1 | head -n 1)"
  else
    sh_ver="${SHELL##*/}"
  fi

  local c_cyan='\033[1;36m'
  local c_blue='\033[1;34m'
  local c_green='\033[1;32m'
  local c_yellow='\033[1;33m'
  local c_gray='\033[0;90m'
  local c_nc='\033[0m'

  printf "%b================================================================%b\n" "$c_blue" "$c_nc"
  printf " %bDotfiles Environment Inspection%b (%s)\n" "$c_cyan" "$c_nc" "$hname"
  printf "%b================================================================%b\n" "$c_blue" "$c_nc"
  printf "  %bMachine Type%b   : %b%-16s%b (Arch: %s)\n" "$c_blue" "$c_nc" "$c_green" "$machine_type" "$c_nc" "$arch_type"
  printf "  %bOS Type%b        : %b%-16s%b (Kernel: %s)\n" "$c_blue" "$c_nc" "$c_green" "$os_type" "$c_nc" "$(uname -r 2>/dev/null)"
  if [ "$machine_type" = "server" ] || [ "$machine_type" = "pveserver" ] || [ "$server_type" != "unknown" ]; then
    printf "  %bServer Type%b    : %b%-16s%b\n" "$c_blue" "$c_nc" "$c_yellow" "$server_type" "$c_nc"
  fi
  printf "  %bShell Type%b     : %b%-16s%b (Version: %s)\n" "$c_blue" "$c_nc" "$c_green" "$shell_type" "$c_nc" "$sh_ver"
  if [ -n "$virt_role" ]; then
    printf "  %bVirtualization%b : %b%-16s%b %s\n" "$c_blue" "$c_nc" "$c_green" "$virt" "$c_nc" "$virt_role"
  else
    printf "  %bVirtualization%b : %b%-16s%b\n" "$c_blue" "$c_nc" "$c_green" "$virt" "$c_nc"
  fi
  printf "  %bPackage Mgr%b    : %b%-16s%b (Sync: %s)\n" "$c_blue" "$c_nc" "$c_green" "$pkg_mgr" "$c_nc" "$stow_mode"
  printf "%b----------------------------------------------------------------%b\n" "$c_gray" "$c_nc"
  printf "  %bDOTFILES_HOME%b  : %s\n" "$c_blue" "$c_nc" "${DOTFILES_HOME:-$HOME}"
  printf "  %bALIASES_HOME%b   : %s\n" "$c_blue" "$c_nc" "${ALIASES_HOME:-$HOME}"
  printf "  %bDEBUG Status%b   : DOTFILES_DEBUG=%s\n" "$c_blue" "$c_nc" "${DOTFILES_DEBUG:-0}"

  if [ -n "${MEDIADIR:-}" ] || [ -n "${DATADIR:-}" ] || [ -n "${DOCKERDIR:-}" ] || [ -n "${CLIENTDIR:-}" ] || [ -n "${SERVERDIR:-}" ]; then
    printf "%b----------------------------------------------------------------%b\n" "$c_gray" "$c_nc"
    [ -n "${MEDIADIR:-}" ]   && printf "  %bMEDIADIR%b       : %s\n" "$c_blue" "$c_nc" "$MEDIADIR"
    [ -n "${DATADIR:-}" ]    && printf "  %bDATADIR%b        : %s\n" "$c_blue" "$c_nc" "$DATADIR"
    [ -n "${NVMEDIR:-}" ]    && printf "  %bNVMEDIR%b        : %s\n" "$c_blue" "$c_nc" "$NVMEDIR"
    [ -n "${DOCKERDIR:-}" ]  && printf "  %bDOCKERDIR%b      : %s\n" "$c_blue" "$c_nc" "$DOCKERDIR"
    [ -n "${CLIENTDIR:-}" ]  && printf "  %bCLIENTDIR%b      : %s\n" "$c_blue" "$c_nc" "$CLIENTDIR"
    [ -n "${SERVERDIR:-}" ]  && printf "  %bSERVERDIR%b      : %s\n" "$c_blue" "$c_nc" "$SERVERDIR"
  fi

  local host_stem="${hname%%.*}"
  local host_prof="${ALIASES_HOME}/.profile.${host_stem}"
  if [ -f "$host_prof" ]; then
    printf "%b----------------------------------------------------------------%b\n" "$c_gray" "$c_nc"
    printf "  %bHost Profile%b   : %s\n" "$c_blue" "$c_nc" "$host_prof"
  fi
  printf "%b================================================================%b\n" "$c_blue" "$c_nc"
}
dotdebug() { dotinfo "$@"; }

# batch copy to recursively copy from a list of directories or files
batch_copy() {
  local list_file="$1"
  local src_dir="$2"
  local dest_dir="$3"

  # Use following commands to generate the batch copy list
  # Standard items (excluding hidden files): printf '%s\n' * > list.txt
  # Include hidden files and folders: (shopt -s nullglob dotglob; printf '%s\n' * > list.txt)
  # Directories only: printf '%s\n' */ | sed 's|/$||' > list.txt

  if [[ -z "$list_file" || -z "$src_dir" || -z "$dest_dir" ]]; then
    echo "Usage: batch_copy <list_file> <source_dir> <destination_dir>" >&2
    return 1
  fi

  if [[ ! -f "$list_file" ]]; then
    echo "Error: List file '$list_file' not found." >&2
    return 1
  fi

  mkdir -p "$dest_dir" || return 1

  while IFS= read -r item || [[ -n "$item" ]]; do
    # Strip carriage returns (CRLF) and leading/trailing whitespace
    item="${item%$'\r'}"
    item="$(echo -e "${item}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

    # Skip empty lines and comment lines
    [[ -z "$item" || "$item" =~ ^# ]] && continue

    local source_path="${src_dir%/}/$item"

    if [[ -e "$source_path" ]]; then
      echo "Copying: $item"
      # -a preserves permissions, symlinks, timestamps, and copies recursively
      cp -a "$source_path" "$dest_dir/"
    else
      echo "Warning: '$source_path' does not exist, skipping." >&2
    fi
  done <"$list_file"
}

# function to recursively archive an entire folder
tardir() {
  local target="${1%/}"
  if [[ ! -e "$target" ]]; then
    echo "Error: '$target' does not exist." >&2
    return 1
  fi

  # Archives parent directory + contents, including dotfiles and direct files
  tar -czvf "${target}_$(date +%Y-%m-%d).tar.gz" "$target"
}

# sets up tmux plugins
setuptmux() {
  local tpm_path="${HOME}/.tmux/plugins/tpm"
  local config_src="${DOTFILES_HOME}/dotfiles/home/.config/tmux/tmux.conf"
  local config_dest="${HOME}/.tmux.conf"

  # 1 & 2: Handle TPM directory and repo
  if [ ! -d "$tpm_path/.git" ]; then
    echo "Installing TPM..."
    mkdir -p "$(dirname "$tpm_path")"
    git clone --depth=1 https://github.com/tmux-plugins/tpm "$tpm_path"
    echo "Done... now exit and re-run tmux and press <Prefix> + I (caps) to install plugins"
  else
    echo "TPM already installed."
  fi

  # 3: Handle tmux.conf symlink
  if [ -f "$config_src" ]; then
    if [ "$(readlink "$config_dest")" != "$config_src" ]; then
      echo "Creating symlink for tmux.conf..."
      ln -sf "$config_src" "$config_dest"
    else
      echo "Symlink already correct."
    fi
  else
    echo "Warning: Source config $config_src not found."
  fi
}

# more flexible flac2alac, can take a single file, wildcard or directory as input
flac2alac() {
  # 1. Check for ffmpeg
  if ! command -v ffmpeg &>/dev/null; then
    echo "Error: 'ffmpeg' is not installed."
    return 1
  fi

  # 2. Usage check
  if [ "$#" -eq 0 ]; then
    echo "Usage: flac2alac <file.flac | *.flac | directory>"
    return 1
  fi

  # 3. Process each argument
  for arg in "$@"; do
    # -L follows symlinks; -type f finds files
    # -maxdepth 1 keeps it in the specified dir
    find "$arg" -maxdepth 1 -type f -name "*.flac" -print0 | while IFS= read -r -d '' input_file; do

      # Correctly strip .flac and add .m4a
      local output_file="${input_file%.flac}.m4a"

      echo "Converting: $(basename "$input_file")"

      # 4. The -nostdin fix
      # This prevents ffmpeg from eating the next filename in your loop!
      ffmpeg -hide_banner -loglevel error -stats -nostdin -n -i "$input_file" -c:a alac -c:v copy "$output_file"

    done
  done
}

mkcd() {
  case $# in
  1)
    mkdir -p "$1"
    cd "$1" || return
    ;;
  *)
    info "USAGE : mkcd <directory>"
    ;;
  esac
}

# for machines without gnu stow
manualstow() {
  if [[ "${MACHINE_TYPE}" == "embedded" ]] || [[ "${MACHINE_TYPE}" == "router" ]]; then
    echo "Manual stow not available on ${MACHINE_TYPE}"
  else
    # manually copy all dot files and directories
    SOURCE_DIR="${HOME}/dotfiles/home"
    DEST_DIR="${HOME}"
    cp -a "${SOURCE_DIR}/." "${DEST_DIR}/"
  fi
}
#########################################

alias clonedot="git clone --depth=1 --single-branch --branch main https://github.com/anirudhra/dotfiles"

# Update dotfiles repository with automatic recovery for diverged branches
redot() {
  local df_dir="${DOTFILES_HOME:-${HOME}}/dotfiles"
  if [ -d "$df_dir" ]; then
    (
      cd "$df_dir" || return 1
      echo "==> Updating dotfiles in $df_dir..."
      git fetch origin
      local cur_branch
      cur_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")"
      if [ "$cur_branch" = "HEAD" ] || [ -z "$cur_branch" ]; then
        cur_branch="main"
      fi
      if ! git pull --ff-only 2>/dev/null; then
        echo "Notice: Fast-forward pull not possible on '$cur_branch'. Resetting to origin/$cur_branch..."
        git reset --hard "origin/$cur_branch"
      fi
      git reflog expire --expire=now --all 2>/dev/null || true
      git prune --expire=now 2>/dev/null || true
      git repack -a -d -f --depth=250 --window=250 2>/dev/null || git gc --prune=now 2>/dev/null || true
    )
    if [ -x "${df_dir}/common/scripts/dotsync.sh" ] && { [ "${MACHINE_TYPE:-}" = "embedded" ] || [ "${MACHINE_TYPE:-}" = "router" ] || ! command -v stow >/dev/null 2>&1; }; then
      "${df_dir}/common/scripts/dotsync.sh"
    elif command -v stow >/dev/null 2>&1; then
      (cd "${df_dir}/home" && stow --verbose=1 --target="${HOME}" --stow --adopt . && git restore . && stow --verbose=1 --target="${HOME}" --restow .)
    else
      manualstow
    fi
  else
    echo "Error: Dotfiles directory not found: $df_dir" >&2
    return 1
  fi
}
alias dotupdate='redot'
alias getdot='
  cd "$DOTFILES_HOME" &&
  wget -O main.tar.gz "https://github.com/anirudhra/dotfiles/archive/refs/heads/main.tar.gz" &&
  rm -rf "$DOTFILES_HOME/dotfiles-bak" &&
  [ ! -d "$DOTFILES_HOME/dotfiles" ] || mv "$DOTFILES_HOME/dotfiles" "$DOTFILES_HOME/dotfiles-bak" &&
  tar -xzf main.tar.gz &&
  mv "$DOTFILES_HOME/dotfiles-main" "$DOTFILES_HOME/dotfiles" &&
  rm -f main.tar.gz
'

alias u='upgrade'

# google agy harness
alias sudoagy="agy --dangerously-skip-permissions"

# ansible aliases
alias dfupdateall="goans && ./ans.sh dfupdateall && cd -"
alias pveupgradeall="goans && ./ans.sh upgradeall && cd -"

export lscolors="auto"
export lesscolors=""
# if the terminal supports colors, set lscolors to always
if [ "${TERM}" = "xterm-kitty" ] || [ "${TERM}" = "xterm-256color" ] || [ "${TERM}" = "screen-256color" ]; then
  export lscolors="always"
  export lesscolors="-R"
fi

# default pagination
export pages="less ${lesscolors}"
# check if most is installed, if so, replace less with most
if command -v most >/dev/null 2>&1; then
  export pages="most"
fi

# Enable syntax-highlighting in less/cat
# Note: needs source-highlight and highlight brew packages for these to work
alias lessc="less -R"
alias more="${pages}"

# if eza is installed, replace ls with eza
if command -v eza >/dev/null 2>&1; then

  export EZA_CONFIG_DIR="${HOME}/.config/eza"
  unalias ls >/dev/null 2>&1

  # only show icons on client machines and macs, not on remote machines
  if [[ "${OS_TYPE}" == "macos" ]] || [[ "${MACHINE_TYPE}" == "client" ]]; then
    icons_enabled="--icons"
  else
    icons_enabled=""
  fi

  ## ls aliases
  alias ls='eza ${icons_enabled} --color=${lscolors} -F -G'
  #export LSCOLORS=gxBxhxDxfxhxhxhxhxcxcx
  alias ll="eza -la ${icons_enabled} --color=${lscolors} --header --git | ${pages}"
  ## Show hidden files ##
  alias ll.="eza -l -d -F -G ${icons_enabled} --color=${lscolors} .* | ${pages}"
  alias ls.='eza -d -F -G ${icons_enabled} --color=${lscolors} .*'
  alias l='eza -lah ${icons_enabled}'                  #size,show type,human readable
  alias la='eza -laAh -F ${icons_enabled}'             #long list,show almost all,show type,human readable
  alias lr='eza ${icons_enabled} -F -R -h -t modified' #sorted by date,recursive,show type,human readable
  alias lt='eza ${icons_enabled} -lh -F -t modified'   #long list,sorted by date,show type,human readable
  alias ldot='eza ${icons_enabled} -ld .*'
  alias lS='eza ${icons_enabled} -F -1S -s name'
  alias lart='eza ${icons_enabled} -1artm -F'
  alias lrt='eza ${icons_enabled} -1rtm -F'
  alias lsr='eza ${icons_enabled} -lARh -F' #Recursive list of files and directories
  alias lsn='eza ${icons_enabled} -1'       #A column contains name of files and directories
  # Detailed listings with icons and Git status
  alias lsd='eza -l ${icons_enabled} --git'
  alias lsa='eza -la ${icons_enabled} --git'
  # Tree view
  # alias tree='eza --tree --level=2' # Adjust --level for desired depth
  # Show hidden files and directories
  alias lh='eza -la ${icons_enabled} --header --icons --git'
  # Sort by modification time, newest first
  alias lsnew='eza ${icons_enabled} -l --sort newest'
  # Sort by size, largest first
  alias lss='eza ${icons_enabled} -l --sort size'
  # Show file permissions in octal
  alias lso='eza ${icons_enabled} -l --octal-permissions'
  # List directories only
  alias lsdir='eza -D ${icons_enabled}'
  # List files only
  alias lsfiles='eza -F ${icons_enabled}'
else
  ## ls aliases
  ## Colorize the ls output ##
  alias ls='ls --color=${lscolors} -F'
  #export LSCOLORS=gxBxhxDxfxhxhxhxhxcxcx
  alias ll="ls -la --color=${lscolors} | ${pages}"
  ## Show hidden files ##
  alias ll.="ls -l -d -F --color=${lscolors} .* | ${pages}"
  alias ls.='ls -d -F --color=${lscolors} .*'
  alias l='ls -lFh'   #size,show type,human readable
  alias la='ls -lAFh' #long list,show almost all,show type,human readable
  alias lr='ls -tRFh' #sorted by date,recursive,show type,human readable
  alias lt='ls -ltFh' #long list,sorted by date,show type,human readable
  alias ldot='ls -ld .*'
  alias lS='ls -1FSsh'
  alias lart='ls -1Fcart'
  alias lrt='ls -1Fcrt'
  alias lsr='ls -lARFh' #Recursive list of files and directories
  alias lsn='ls -1'     #A column contains name of files and directories
fi

