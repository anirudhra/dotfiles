#!/bin/sh
# This file is to be used only on DD-WRT/OpenWRT routers that have temp root home directory
# This file must be called by the startup script to set the correct directories for proper alias/script sourcing

#This file is called before the router specific .profile.<hostname> is called, in order to set the correct directories and symlinks.
#This is necessary as ddwrt's ${HOME} is a ramdisk and gets wiped on reboot

# on-chip emmc, that may get wiped across boots or firmware upgrades
export JFFS_ROOT_HOME="/root"

# use one of the ROOT_HOMEs not both, pick emmc or usb mounted on /opt
export ROOT_HOME="/opt/root" #this is persistent on usb
export DOTFILES_HOME="${ROOT_HOME}"

# always fixed relative to DOTFILES_HOME
export ALIASES_HOME="${DOTFILES_HOME}/dotfiles/home"

ln -s "${DOTFILES_HOME}/dotfiles" "${JFFS_ROOT_HOME}/dotfiles" >/dev/null 2>&1

# use entware-specific ddwrt vimrc file instead of standard one as not all options are supported
ln -s "${ALIASES_HOME}/.vimrc.entware" "${JFFS_ROOT_HOME}/.vimrc" >/dev/null 2>&1
ln -s "${ALIASES_HOME}/.vim" "${JFFS_ROOT_HOME}/.vim" >/dev/null 2>&1
ln -s "${ALIASES_HOME}/.config" "${JFFS_ROOT_HOME}/.config" >/dev/null 2>&1

# Fallback for OpenWrt missing the hostname binary, to detect openwrt device
if [ -f /etc/openwrt_release ] && ! command -v hostname >/dev/null 2>&1; then
  alias hostname="uci -q get system.@system[0].hostname || echo 'OpenWrt'"
fi

#alias themeinstall="wget -qO- https://openwrt.eamonxg.fun/install.sh | CHANNEL=releases sh"

# source .profile, that will source .aliases
. "${ALIASES_HOME}/.profile"
