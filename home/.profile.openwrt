#!/bin/sh
# OpenWrt setup; source before the router-specific hostname profile.

# Internal root home and preferred USB storage are separate.
export JFFS_ROOT_HOME="/root"
export ROOT_HOME="/opt/root"
WRT_LINK_HOME="${JFFS_ROOT_HOME}"

# Honor an override; otherwise prefer USB, then internal storage.
if [ -z "${DOTFILES_HOME:-}" ]; then
  if [ -d "${ROOT_HOME}" ]; then
    DOTFILES_HOME="${ROOT_HOME}"
  else
    DOTFILES_HOME="${JFFS_ROOT_HOME}"
  fi
fi
export DOTFILES_HOME

# Fail clearly rather than silently selecting another configuration tree.
if [ ! -r "${DOTFILES_HOME}/dotfiles/home/.profile.wrt" ]; then
  printf 'Common router profile not readable: %s\n' \
    "${DOTFILES_HOME}/dotfiles/home/.profile.wrt" >&2
  return 1
fi

# Fallback for firmware without a hostname binary.
if [ -f /etc/openwrt_release ] && ! command -v hostname >/dev/null 2>&1; then
  alias hostname="uci -q get system.@system[0].hostname || echo 'OpenWrt'"
fi

#alias themeinstall="wget -qO- https://openwrt.eamonxg.fun/install.sh | CHANNEL=releases sh"

. "${DOTFILES_HOME}/dotfiles/home/.profile.wrt"
