#!/bin/sh
# Shared ash-compatible login setup; source from the platform profile.

# Run once per shell and block recursive sourcing; safe with set -u.
# Do not export this guard: child shells initialize independently.
if [ -n "${SOURCED_PROFILE_WRT:-}" ]; then
  return 0
fi

export ALIASES_HOME="${DOTFILES_HOME}/dotfiles/home"
if [ ! -r "${ALIASES_HOME}/.profile" ]; then
  return 1
fi
SOURCED_PROFILE_WRT=1

# Skip existing files, directories, and even dangling symlinks.
# This prevents ln from creating nested links inside directory destinations.
create_symlink_if_missing() {
  if [ ! -e "$2" ] && [ ! -L "$2" ]; then
    ln -s "$1" "$2" >/dev/null 2>&1
  fi
  return 0
}

FASTFETCH_BIN="/opt/bin/fastfetch"

# Restore configuration links in the platform's login home after reboot.
create_symlink_if_missing "${DOTFILES_HOME}/dotfiles" "${WRT_LINK_HOME}/dotfiles"
# Use the Entware-specific vimrc for its supported options.
create_symlink_if_missing "${ALIASES_HOME}/.vimrc.entware" "${WRT_LINK_HOME}/.vimrc"
create_symlink_if_missing "${ALIASES_HOME}/.vim" "${WRT_LINK_HOME}/.vim"
create_symlink_if_missing "${ALIASES_HOME}/.config" "${WRT_LINK_HOME}/.config"
create_symlink_if_missing "${DOTFILES_HOME}/dotfiles/common/scripts/routerfastfetch" "${FASTFETCH_BIN}"
unset -f create_symlink_if_missing

# Add USB tools and load the existing home profile (which sources aliases).
export PATH="/opt/bin:${PATH}"
. "${ALIASES_HOME}/.profile"

#uname -a
[ -f "${FASTFETCH_BIN}" ] && [ -x "${FASTFETCH_BIN}" ] && "${FASTFETCH_BIN}"
