# wifi reset for ifc6410 dev board
wifi-reset() {
  if [[ "${MACHINE_TYPE}" == "sbc" ]]; then

    local target_ssid="${1:-Tank}"
    local sdio_dev="mmc1:0001:1"
    local sdio_driver="/sys/bus/sdio/drivers/ath6kl_sdio"

    # Ensure root execution
    if [[ $EUID -ne 0 ]]; then
      echo "[!] wifi-reset requires root privileges. Escalating..." >&2
      sudo -E zsh -c "$(typeset -f wifi-reset); wifi-reset '$target_ssid'"
      return $?
    fi

    echo "==> Stopping network managers..."
    systemctl stop NetworkManager wpa_supplicant 2>/dev/null

    # Reset the physical SDIO target to trigger SRAM/firmware reload
    if [[ -d "$sdio_driver" ]]; then
      if [[ -e "$sdio_driver/$sdio_dev" ]]; then
        echo "==> Detaching SDIO target ($sdio_dev)..."
        echo "$sdio_dev" >"$sdio_driver/unbind"
        sleep 1
      fi

      echo "==> Re-binding SDIO target ($sdio_dev)..."
      echo "$sdio_dev" >"$sdio_driver/bind"
      sleep 2
    else
      echo "[!] ath6kl_sdio driver path not found in sysfs!" >&2
      return 1
    fi

    # Bring up the interface and turn off power management
    echo "==> Bringing wlan0 UP and disabling 802.11 power saving..."
    ip link set wlan0 up
    iw dev wlan0 set power_save off

    echo "==> Starting network services..."
    systemctl start wpa_supplicant NetworkManager
    sleep 3

    echo "==> Associating with '$target_ssid'..."
    nmcli connection up "$target_ssid"
  else
    echo "Only supported on IFC6410 SBC"
  fi
}

copyrockboxthemes() {
  # Usage:
  #   copyrockboxthemes            # copy from current dir's backdrops/fonts/icons/themes/wps
  #   copyrockboxthemes <srcdir>   # for each subdir of <srcdir>, cd into .rockbox and copy contents
  if [[ "${MACHINE_TYPE}" == "client" ]]; then
    local mountbasedir="/run/media/anirudh"
    local ipod_base=""

    if [ -d "${mountbasedir}/IPOD7G" ]; then
      ipod_base="${mountbasedir}/IPOD7G"
    elif [ -d "${mountbasedir}/IPOD5G" ]; then
      ipod_base="${mountbasedir}/IPOD5G"
    else
      warn "Neither ${mountbasedir}/IPOD7G nor ${mountbasedir}/IPOD5G found"
      return 1
    fi

    local ipoddir="${ipod_base}/.rockbox"
    if [ ! -d "${ipoddir}" ]; then
      warn ".rockbox directory not found in ${ipod_base}"
      return 1
    fi

    mkdir -p "${ipoddir}/backdrops" "${ipoddir}/fonts" "${ipoddir}/icons" "${ipoddir}/themes" "${ipoddir}/wps"

    if [ -n "$1" ]; then
      local srcdir="$1"
      if [ ! -d "${srcdir}" ]; then
        warn "Source directory ${srcdir} not found"
        return 1
      fi

      find "${srcdir}" -maxdepth 1 -type d \( ! -name . \) -exec bash -c "cd '{}' && if [ -d .rockbox ]; then cd .rockbox && pwd ; \
        cp -r backdrops/* \"${ipoddir}/backdrops/\" 2>/dev/null || true ; \
        cp -r fonts/* \"${ipoddir}/fonts/\" 2>/dev/null || true ; \
        cp -r icons/* \"${ipoddir}/icons/\" 2>/dev/null || true ; \
        cp -r themes/* \"${ipoddir}/themes/\" 2>/dev/null || true ; \
        cp -r wps/* \"${ipoddir}/wps/\" 2>/dev/null || true ; fi" \;
    else
      cp -r backdrops/* "${ipoddir}/backdrops/" 2>/dev/null || true
      cp -r fonts/* "${ipoddir}/fonts/" 2>/dev/null || true
      cp -r icons/* "${ipoddir}/icons/" 2>/dev/null || true
      cp -r themes/* "${ipoddir}/themes/" 2>/dev/null || true
      cp -r wps/* "${ipoddir}/wps/" 2>/dev/null || true
    fi
  fi
}

# this function copies the compiled kernel image and modules archives into "artifacts" directory
# and creates 3 versions of the kernel image to boot from: sda1, emmc and sdcard
# Run this on the host that builds the Linux kernel
getsbckernels() {
  if [[ "${MACHINE_TYPE}" == "pveguest" ]]; then
    local TARGET_USER="${SBC_USER:-nonroot}"
    local TARGET_GROUP="${SBC_GROUP:-${TARGET_USER}}"

    local DATE=$(date +%Y%m%d)
    local KERNEL_VER="6.6.9"

    local KERNEL_IMG_BUILDNAME="boot-qcom-apq8064-ifc6410-qcom-armv7a.img"
    local MODULES_TAR_BUILDNAME="modules-qcom-armv7a.tgz"
    local KERNEL_IMG_BASE="boot-ifc6410-armv7a-${KERNEL_VER}-${DATE}"
    local MODULES_TAR="modules-ifc6410-armv7a-${KERNEL_VER}-${DATE}.tgz"
    local KERNEL_DTB_BUILDNAME="qcom-apq8064-ifc6410.dtb"

    local KERNEL_IMG_SDA1="${KERNEL_IMG_BASE}-sda1.img"
    local KERNEL_IMG_SDCARD="${KERNEL_IMG_BASE}-sdcard.img"
    local KERNEL_IMG_EMMC="${KERNEL_IMG_BASE}-emmc.img"

    local BUILD_DIR="./tmp/deploy/images/qcom-armv7a"
    local KERNEL_CONFIG="./tmp/work-shared/qcom-armv7a/kernel-build-artifacts/.config"
    local KERNEL_DEFCONFIG="defconfig"
    local WORKING_DIR="."
    local ARTIFACTS_DIR="${WORKING_DIR}/artifacts"

    # Command lines
    local CMDLINE_COMMON="rw rootwait console=ttyMSM0,115200n8 libata.force=1.5Gbps,noncq systemd.unit=multi-user.target systemd.unified_cgroup_hierarchy=1"
    local CMDLINE_SDA1="root=/dev/sda1 ${CMDLINE_COMMON}"
    local CMDLINE_EMMC="root=/dev/mmcblk2p13 ${CMDLINE_COMMON}"
    local CMDLINE_SDCARD="root=/dev/mmcblk0p1 ${CMDLINE_COMMON}"

    # create a backup if directory already exists
    if [ -d "${ARTIFACTS_DIR}" ]; then
      rm -rf "${ARTIFACTS_DIR}_backup"
      mv -f "${ARTIFACTS_DIR}" "${ARTIFACTS_DIR}_backup"
    fi

    # copy build artifacts
    mkdir -p "${ARTIFACTS_DIR}"
    sudo cp -f "${BUILD_DIR}/${MODULES_TAR_BUILDNAME}" "${ARTIFACTS_DIR}/"
    sudo cp -f "${BUILD_DIR}/${KERNEL_IMG_BUILDNAME}" "${ARTIFACTS_DIR}/"
    sudo cp -f "${BUILD_DIR}/${KERNEL_DTB_BUILDNAME}" "${ARTIFACTS_DIR}/"
    sudo cp -f "${KERNEL_CONFIG}" "${ARTIFACTS_DIR}/${KERNEL_DEFCONFIG}"
    info "Copied ${KERNEL_IMG_BUILDNAME}, ${MODULES_TAR_BUILDNAME} and ${KERNEL_DEFCONFIG}"

    cd "${ARTIFACTS_DIR}" || return 1
    sudo chown -R "${TARGET_USER}:${TARGET_GROUP}" *

    # rename and replicate target images
    mv -f "${MODULES_TAR_BUILDNAME}" "${MODULES_TAR}"
    cp -f "${KERNEL_IMG_BUILDNAME}" "${KERNEL_IMG_SDA1}"
    cp -f "${KERNEL_IMG_BUILDNAME}" "${KERNEL_IMG_SDCARD}"
    mv -f "${KERNEL_IMG_BUILDNAME}" "${KERNEL_IMG_EMMC}"

    # update cmdline inline without extracting or writing temporary configs
    abootimg -u "${KERNEL_IMG_SDA1}" -c "cmdline=${CMDLINE_SDA1}"
    abootimg -u "${KERNEL_IMG_SDCARD}" -c "cmdline=${CMDLINE_SDCARD}"
    abootimg -u "${KERNEL_IMG_EMMC}" -c "cmdline=${CMDLINE_EMMC}"

    cd - >/dev/null || return 1
  fi
}

