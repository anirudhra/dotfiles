#intended to be run on PVE guests/SBC only
# Note: Syntax error fixed on conditional check (removed stray extra '; };' before 'then')
dockerupdateall() {
  local docker_host=false
  if [[ "${MACHINE_TYPE}" == "pveguest" ]] || [[ "${MACHINE_TYPE}" == "sbc" ]] ||
    { [[ "${MACHINE_TYPE}" == "pveserver" ]] && { [[ "${SERVER_TYPE}" == "openmediavault" ]] || [[ "${SERVER_TYPE}" == "truenas" ]]; }; }; then
    docker_host=true
  fi

  if [[ "${docker_host}" != "true" ]]; then
    warn "dockerupdateall not supported on this platform"
    return 1
  fi

  if ! command -v docker >/dev/null 2>&1; then
    warn "docker is not installed on this platform"
    return 1
  fi
  if [[ -z "${DOCKERDIR:-}" ]] || [[ ! -d "${DOCKERDIR}" ]]; then
    warn "Set DOCKERDIR to an existing Docker Compose directory before running dockerupdateall"
    return 1
  fi

  local original_dir="${PWD}"
  cd "${DOCKERDIR}" || return 1
  find . -maxdepth 1 -type d \( ! -name . \) -not -path '*disabled*' -exec bash -c "cd '{}' && pwd && docker compose down && docker compose pull && docker compose up -d --remove-orphans" \;
  docker image prune -a -f
  docker system prune --volumes -f
  cd "${original_dir}" || return 1
}

#intended to be run on PVE guests/SBC/Client only
movemovie() {
  if [[ "${MACHINE_TYPE}" == "pveguest" ]] || [[ "${MACHINE_TYPE}" == "sbc" ]] || [[ "${MACHINE_TYPE}" == "client" ]]; then
    case $# in
    1)
      chmod 777 "$1"
      chown -R nobody:nogroup "$1"
      mv "$1" "${MEDIADIR}/video/MyMovies"
      ;;
    *)
      info "USAGE : movemovie <movie_dir>"
      ;;
    esac
  fi
}

