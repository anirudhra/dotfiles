# Common Docker shortcuts & consolidated dockerbackup function
# Placed in a single block guarded by docker existence to serve all platforms cleanly
if command -v docker >/dev/null 2>&1; then
  alias dockerup='docker compose up -d'
  alias dockerdown='docker compose down'
  alias dockerrestart='docker compose down && docker compose up -d'
  alias dockerupdate='docker compose down && docker compose pull && docker compose up -d --remove-orphans && docker image prune -f && docker system prune --volumes'
  alias dockerclean='docker system prune --volumes'

  # Universal dockerbackup function: dynamically resolves date at run-time,
  # validates paths, and adapts seamlessly across SBC, LXC, and NAS configurations.
  dockerbackup() {
    local src_dir="${DOCKERDIR:-/opt/dockerapps}"
    local backup_dest="${DOCKERBACKUPDIR:-${DATADIR:-$HOME}}"

    if [[ ! -d "${src_dir}" ]]; then
      warn "Set DOCKERDIR to an existing Docker Compose directory before running dockerbackup: ${src_dir}"
      return 1
    fi

    if [[ ! -d "${backup_dest}" ]]; then
      warn "Docker backup destination directory does not exist: ${backup_dest}"
      return 1
    fi

    sudo tar -zcvf "${backup_dest}/dockerapps_backup_${HOSTNAME}_$(date -I).tar.gz" "${src_dir}"
  }
fi

