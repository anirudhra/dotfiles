#!/bin/sh
# Lightweight router summary for BusyBox ash; execute rather than source.
# Highly optimized for low-power embedded CPUs (MIPS/ARM).
# (c) Anirudh Acharya 2024, 2025, 2026

# Set to 1 to enable OpenWrt ASCII logo, 0 to disable (default: 0)
SHOW_OPENWRT_LOGO=${SHOW_OPENWRT_LOGO:-0}
# Set to 1 to enable DD-WRT ASCII logo, 0 to disable (default: 1)
SHOW_DDWRT_LOGO=${SHOW_DDWRT_LOGO:-1}

has_command() { command -v "$1" >/dev/null 2>&1; }

show_field() {
  [ -n "$2" ] || return 0
  printf '  %-13s %s\n' "$1:" "$2"
}

# Identify firmware; keep hardware model separate from hostname.
FIRMWARE=linux
OS_NAME="Generic Linux Router"
MODEL=

if [ -f /etc/openwrt_release ]; then
  FIRMWARE=openwrt
  # shellcheck source=/dev/null
  . /etc/openwrt_release
  OS_NAME=${DISTRIB_DESCRIPTION:-OpenWrt}
  if has_command ubus && has_command jsonfilter; then
    MODEL=$(ubus call system board 2>/dev/null | jsonfilter -e '@.model' 2>/dev/null)
  fi
elif [ -f /etc/nvram.txt ] || nvram get os_name >/dev/null 2>&1; then
  # DD-WRT detection
  FIRMWARE=ddwrt
  OS_NAME=$(nvram get os_name 2>/dev/null)
  [ -z "$OS_NAME" ] && OS_NAME="DD-WRT"
  OS_VERSION=$(nvram get os_version 2>/dev/null)
  [ -z "$OS_VERSION" ] || OS_NAME="$OS_NAME $OS_VERSION"
  MODEL=$(nvram get DD_BOARD 2>/dev/null)
fi

# Remove device-tree NUL terminators before shell assignment
if [ -z "$MODEL" ]; then
  for MODEL_FILE in /proc/device-tree/model /sys/firmware/devicetree/base/model; do
    if [ -r "$MODEL_FILE" ]; then
      MODEL=$(tr -d '\000' <"$MODEL_FILE" 2>/dev/null)
      [ -z "$MODEL" ] || break
    fi
  done
fi
MODEL=${MODEL:-Unknown}

# Hostname via shell builtin read (0 fork/exec)
HOST_NAME=
if [ -r /proc/sys/kernel/hostname ]; then
  read -r HOST_NAME < /proc/sys/kernel/hostname 2>/dev/null
fi
if [ -z "$HOST_NAME" ] && has_command hostname; then
  HOST_NAME=$(hostname 2>/dev/null)
fi
HOST_NAME=${HOST_NAME:-Unknown}

KERNEL=$(uname -r 2>/dev/null)
ARCH=$(uname -m 2>/dev/null)

# Single-pass CPU and Core extraction from /proc/cpuinfo (1 awk call instead of 2)
CPU=
CORES=
if [ -r /proc/cpuinfo ]; then
  eval "$(awk -F: '
    function clean(s) {sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s}
    {key=tolower(clean($1)); val=clean($2)}
    key=="model name" && name=="" {name=val}
    key=="cpu model" && model=="" {model=val}
    key=="hardware" && hw=="" {hw=val}
    key=="system type" && sys=="" {sys=val}
    key=="processor" && val !~ /^[0-9]+$/ && proc=="" {proc=val}
    tolower($1) ~ /^processor[ \t]*$/ {cores++}
    END {
      cpu = (name!="" ? name : (model!="" ? model : (sys!="" ? sys : (hw!="" ? hw : proc))));
      gsub(/["\\]/, "\\\\&", cpu);
      print "CPU=\"" cpu "\"";
      print "CORES=\"" (cores ? cores : "") "\"";
    }' /proc/cpuinfo 2>/dev/null)"
fi
CPU=${CPU:-${ARCH:-Unknown}}

# Uptime via shell builtin read + arithmetic (0 fork/exec)
UPTIME=""
if [ -r /proc/uptime ]; then
  read -r up_sec _ < /proc/uptime 2>/dev/null
  up_s=${up_sec%%.*}
  d=$((up_s / 86400))
  h=$(( (up_s % 86400) / 3600 ))
  m=$(( (up_s % 3600) / 60 ))
  [ "$d" -gt 0 ] && UPTIME="${d}d "
  UPTIME="${UPTIME}${h}h ${m}m"
fi

# Load Average via shell builtin read (0 fork/exec)
LOAD=""
if [ -r /proc/loadavg ]; then
  read -r l1 l5 l15 _ < /proc/loadavg 2>/dev/null
  LOAD="$l1 / $l5 / $l15 (1 / 5 / 15 min)"
fi

# Single-pass Memory and Swap extraction from /proc/meminfo (1 awk call instead of 2)
MEMORY=""
SWAP=""
if [ -r /proc/meminfo ]; then
  eval "$(awk '
    /^MemTotal:/ {mt=$2} /^MemAvailable:/ {ma=$2; have_avail=1}
    /^MemFree:/ {mf=$2} /^Buffers:/ {mb=$2} /^Cached:/ {mc=$2}
    /^SReclaimable:/ {mr=$2} /^Shmem:/ {ms=$2}
    /^SwapTotal:/ {st=$2} /^SwapFree:/ {sf=$2}
    END {
      if (mt > 0) {
        if (!have_avail) ma = mf + mb + mc + mr - ms;
        if (ma < 0) ma = 0; if (ma > mt) ma = mt;
        used = mt - ma;
        printf "MEMORY=\"%.1f / %.1f MiB (%.0f%%)%s\"\n", used/1024, mt/1024, 100*used/mt, (have_avail ? "" : " [estimated]");
      }
      if (st > 0) {
        printf "SWAP=\"%.1f / %.1f MiB\"\n", (st-sf)/1024, st/1024;
      } else {
        print "SWAP=\"Disabled\"";
      }
    }' /proc/meminfo 2>/dev/null)"
fi

# Assigned IPv4 addresses
IPV4=
if has_command ip; then
  IPV4=$(ip -4 addr show 2>/dev/null | awk '
    /^[0-9]+:/ {iface=$2; sub(/:$/, "", iface); sub(/@.*/, "", iface)}
    $1=="inet" && $2 !~ /^127\./ {printf "%s%s %s",sep,iface,$2; sep=", "}
    END {if(sep!="") print ""}')
fi
if [ -z "$IPV4" ] && has_command ifconfig; then
  IPV4=$(ifconfig 2>/dev/null | awk '
    /^[^ \t]/ {iface=$1; sub(/:$/, "", iface)}
    /inet / {
      for(i=1;i<=NF;i++) if($i=="inet") {
        addr=$(i+1); sub(/^addr:/, "", addr);
        if(addr !~ /^127\./) {printf "%s%s %s",sep,iface,addr; sep=", "}
      }
    } END {if(sep!="") print ""}')
fi

# Suppress colors when redirected or NO_COLOR is set
USE_COLOR=0
if [ -t 1 ] && [ -z "${NO_COLOR+x}" ]; then USE_COLOR=1; fi

# Determine whether to print logo
PRINT_LOGO=1
if [ "$FIRMWARE" = "openwrt" ] && [ "$SHOW_OPENWRT_LOGO" != "1" ]; then
  PRINT_LOGO=0
elif [ "$FIRMWARE" = "ddwrt" ] && [ "$SHOW_DDWRT_LOGO" != "1" ]; then
  PRINT_LOGO=0
fi

if [ "$PRINT_LOGO" -eq 1 ]; then
  if [ "$USE_COLOR" -eq 1 ]; then
    case "$FIRMWARE" in
    openwrt) printf '\033[33m' ;;
    ddwrt) printf '\033[32m' ;;
    *) printf '\033[36m' ;;
    esac
  fi
  printf '\n'
  case "$FIRMWARE" in
  openwrt)
    printf '%s\n' \
      ' _______                     ________        __' \
      '|       |.-----.-----.-----.|  |  |  |.----.|  |_' \
      '|   -   ||  _  |  -__|     ||  |  |  ||   _||   _|' \
      '|_______||   __|_____|__|__||________||__|  |____|' \
      '         |__|  W I R E L E S S   F R E E D O M'
    ;;
  ddwrt)
    printf '%s\n' \
      '  ____  ____        __        ______ _____' \
      ' |  _ \|  _ \       \ \      / /  _ \_   _|' \
      ' | | | | | | | _____ \ \ /\ / /| |_) || |' \
      ' | |_| | |_| ||_____| \ V  V / |  _ < | |' \
      ' |____/|____/          \_/\_/  |_| \_\|_|'
    ;;
  *) printf '%s\n' ' Router System Summary' ;;
  esac
  if [ "$USE_COLOR" -eq 1 ]; then printf '\033[0m'; fi
  printf '\n'
else
  printf '\n'
fi

show_field Model "$MODEL"
show_field Hostname "$HOST_NAME"
show_field OS "$OS_NAME"
show_field Kernel "$KERNEL"
show_field Architecture "$ARCH"
if [ -n "$CPU" ] && [ "$CPU" != "$ARCH" ]; then
  show_field CPU "$CPU"
fi
show_field 'Logical CPUs' "$CORES"
show_field Uptime "$UPTIME"
show_field Load "$LOAD"
show_field Memory "$MEMORY"
show_field Swap "$SWAP"
show_field IPv4 "${IPV4:-Unavailable}"

# Deduplicate backing filesystems in a single df invocation
if has_command df; then
  DISKS=$(df -Pk / /overlay /jffs /opt /tmp 2>/dev/null | awk '
    function size(k) {
      if(k>=1048576) return sprintf("%.2f GiB",k/1048576);
      return sprintf("%.1f MiB",k/1024)
    }
    NR>1 && NF>=6 && !seen[$NF]++ {
      printf "  %-13s %s / %s (%s), available %s\n", $NF ":", size($3), size($2), $5, size($4)
    }')
  if [ -n "$DISKS" ]; then
    printf '\n  Filesystems (includes RAM-backed mounts):\n%s\n' "$DISKS"
  fi
fi
printf '\n'
